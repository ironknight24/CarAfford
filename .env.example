# =============================================================================
# CarAfford Production & Environment Configuration Template
# Copy this file to .env and provide real credentials for your deployment.
# =============================================================================

# Application Metadata
PROJECT_NAME="CarAfford"
VERSION="1.0.0"
ENVIRONMENT="production"      # development | test | production
DEBUG=false
API_V1_STR="/api/v1"

# Security & Secrets (CRITICAL: Must be unique 32+ character random string in production)
SECRET_KEY="generate-a-strong-random-secret-key-for-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Administrator Seed Configuration
ADMIN_DEFAULT_EMAIL="admin@carafford.in"
ADMIN_DEFAULT_PASSWORD="SetAStrongAdminPassword#2026"
ADMIN_DEFAULT_NAME="CarAfford Administrator"

# PostgreSQL Database Configuration
POSTGRES_SERVER="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="carafford_user"
POSTGRES_PASSWORD="set_secure_db_password"
POSTGRES_DB="carafford_db"
DATABASE_URL="postgresql://carafford_user:set_secure_db_password@postgres:5432/carafford_db"
ASYNC_DATABASE_URL="postgresql+asyncpg://carafford_user:set_secure_db_password@postgres:5432/carafford_db"

# Database Connection Pool Tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Redis Cache & Rate Limiting
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_ENABLED=true

# Rate Limiting Thresholds (Requests per minute per IP/token)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MIN=120
RATE_LIMIT_AUTH_PER_MIN=20
RATE_LIMIT_CALCULATION_PER_MIN=60

# CORS Allowed Origins (Comma-separated or JSON list - NEVER use wildcard '*' in production)
CORS_ORIGINS='["https://carafford.in", "https://www.carafford.in", "https://app.carafford.in"]'

# Frontend Public API Base URL
NEXT_PUBLIC_API_BASE_URL="https://api.carafford.in/api/v1"
