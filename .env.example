# Environment & Application
PROJECT_NAME="CarAfford"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="carafford_user"
POSTGRES_PASSWORD="carafford_secret"
POSTGRES_DB="carafford_db"
# Explicit URLs (optional override):
# DATABASE_URL="postgresql://carafford_user:carafford_secret@localhost:5432/carafford_db"
# ASYNC_DATABASE_URL="postgresql+asyncpg://carafford_user:carafford_secret@localhost:5432/carafford_db"

# Redis Cache
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_ENABLED=true

# Frontend
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"

# Domain Banking Defaults
DEFAULT_FOIR_LIMIT=0.40
DEFAULT_ANNUAL_INTEREST_RATE=8.75
DEFAULT_LOAN_TENURE_MONTHS=60
